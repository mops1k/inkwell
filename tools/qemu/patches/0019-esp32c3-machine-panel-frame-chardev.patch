+    /* Frame dump sink of the e-paper panel, e.g.
+     *   -chardev file,id=xteink-panel,path=build/qemu/frame.bin
+     *   -machine esp32c3,xteink-panel=xteink-panel */
+    object_class_property_add_str(oc, "xteink-panel",
+                                  esp32c3_machine_get_panel,
+                                  esp32c3_machine_set_panel);
 }
 

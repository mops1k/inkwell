+/* Machine properties. Machines are not TYPE_DEVICE, so these use the QOM string
+ * property API rather than DEFINE_PROP_* (-machine key=value resolves through
+ * object_property_set_str). */
+static char *esp32c3_machine_get_panel(Object *obj, Error **errp)
+{
+    Esp32C3MachineState *ms = ESP32C3_MACHINE(obj);
+
+    return g_strdup(ms->panel_chr_id ? ms->panel_chr_id : "");
+}
+
+static void esp32c3_machine_set_panel(Object *obj, const char *value,
+                                      Error **errp)
+{
+    Esp32C3MachineState *ms = ESP32C3_MACHINE(obj);
+
+    g_free(ms->panel_chr_id);
+    ms->panel_chr_id = g_strdup(value);
+}
+
 /* Initialize machine type */
 static void esp32c3_machine_class_init(ObjectClass *oc, void *data)
 {
     MachineClass *mc = MACHINE_CLASS(oc);
+
     mc->desc = "Espressif ESP32-C3 machine";
     mc->default_cpu_type = TYPE_ESP_RISCV_CPU;
     mc->init = esp32c3_machine_init;
@@ -828,6 +866,12 @@
     mc->default_cpus = 1;

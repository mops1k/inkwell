+/* Command-level trace for board bring-up: SSISD_TRACE=1 prints one line per
+ * command (and one per data block) on stderr, capped so a long boot log stays
+ * readable (SSISD_TRACE_MAX raises the cap). It is what shows that SdFat
+ * mounted the card: CMD17/CMD18 with arg 0 is the MBR, then the partition boot
+ * sector, then the FAT and the directory clusters. */
+#define SSISD_TRACE_LINES 200
+static int ssi_sd_trace_enabled(void)
+{
+    static int cached = -1;
+
+    if (cached < 0) {
+        const char *env = getenv("SSISD_TRACE");
+        cached = (env && *env && *env != '0');
+    }
+    return cached;
+}
+
+static int ssi_sd_trace_max(void)
+{
+    static int cached = -1;
+
+    if (cached < 0) {
+        const char *env = getenv("SSISD_TRACE_MAX");
+        cached = (env && *env) ? atoi(env) : SSISD_TRACE_LINES;
+        if (cached <= 0) {
+            cached = SSISD_TRACE_LINES;
+        }
+    }
+    return cached;
+}
+
+static void G_GNUC_PRINTF(1, 2) ssi_sd_trace(const char *fmt, ...)
+{
+    static int lines;
+    va_list ap;
+
+    if (!ssi_sd_trace_enabled()) {
+        return;
+    }
+    if (lines++ >= ssi_sd_trace_max()) {
+        return;
+    }
+    fprintf(stderr, "ssi_sd: [%" PRId64 " ms] ",
+            qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL));
+    va_start(ap, fmt);
+    vfprintf(stderr, fmt, ap);
+    va_end(ap);
+}
+
+#define SSISD_TRACE(...) ssi_sd_trace(__VA_ARGS__)
+

+/* Effective level seen on a pin: the driven output value, the level injected by
+ * an external device, or the internal pull-up. */
+static unsigned esp32_gpio_pin_level(Esp32GpioState *s, unsigned pin)
+{
+    if (s->gpio_enable & (1u << pin)) {
+        return (s->gpio_out >> pin) & 1;
+    }
+    if (s->gpio_in_mask & (1u << pin)) {
+        return (s->gpio_in >> pin) & 1;
+    }
+    return (s->gpio_pullup >> pin) & 1;
+}
+
+/* Recompute the per-pin interrupt-enable mask and drive the (level) GPIO IRQ
+ * towards the interrupt matrix. */
+static void esp32_gpio_update_irq(Esp32GpioState *s)
+{
+    uint32_t mask = 0;
+    unsigned pin;
+
+    for (pin = 0; pin < s->num_gpios && pin < ESP_GPIO_MAX_PINS; pin++) {
+        if ((s->pin_cfg[pin] >> ESP_GPIO_PIN_INT_ENA_SHIFT) &
+            ESP_GPIO_PIN_INT_ENA_MASK) {
+            mask |= 1u << pin;
+        }
+    }
+    s->int_ena_mask = mask;
+    qemu_set_irq(s->irq, (s->status & mask) != 0);
+}
+
+/* Apply the interrupt configured in PINx_CNF to a level change of one pin. */
+static void esp32_gpio_pin_changed(Esp32GpioState *s, unsigned pin,
+                                   unsigned old_level)
+{
+    unsigned new_level = esp32_gpio_pin_level(s, pin);
+    uint32_t cfg = s->pin_cfg[pin];
+    unsigned type = (cfg >> ESP_GPIO_PIN_INT_TYPE_SHIFT) & 0x7;
+    bool enabled = ((cfg >> ESP_GPIO_PIN_INT_ENA_SHIFT) &
+                    ESP_GPIO_PIN_INT_ENA_MASK) != 0;
+    bool fire = false;
+
+    if (!enabled) {
+        return;
+    }
+
+    switch (type) {
+    case ESP_GPIO_INTR_POSEDGE:
+        fire = old_level == 0 && new_level == 1;
+        break;
+    case ESP_GPIO_INTR_NEGEDGE:
+        fire = old_level == 1 && new_level == 0;
+        break;
+    case ESP_GPIO_INTR_ANYEDGE:
+        fire = old_level != new_level;
+        break;
+    case ESP_GPIO_INTR_LOW_LEVEL:
+        fire = new_level == 0;
+        break;
+    case ESP_GPIO_INTR_HIGH_LEVEL:
+        fire = new_level == 1;
+        break;
+    default:
+        break;
+    }
+
+    if (fire) {
+        s->status |= 1u << pin;
+        esp32_gpio_update_irq(s);
+    }
+}
+
+/* Re-evaluate the effective level of every pin in @candidates (0 = all pins)
+ * and feed the ones that changed into the interrupt logic. */
+static void esp32_gpio_refresh_levels(Esp32GpioState *s, uint32_t candidates)
+{
+    unsigned pin;
+
+    for (pin = 0; pin < s->num_gpios && pin < ESP_GPIO_MAX_PINS; pin++) {
+        unsigned old_level, new_level;
+
+        if (candidates && !(candidates & (1u << pin))) {
+            continue;
+        }
+        old_level = (s->gpio_level >> pin) & 1;
+        new_level = esp32_gpio_pin_level(s, pin);
+        if (old_level != new_level) {
+            s->gpio_level = (s->gpio_level & ~(1u << pin)) | (new_level << pin);
+            esp32_gpio_pin_changed(s, pin, old_level);
+        }
+    }
+}

 static void esp32_gpio_reset_hold(Object *obj, ResetType type)
 {
+    Esp32GpioState *s = ESP32_GPIO(obj);
+
+    s->status = 0;
+    s->gpio_level = 0;
+    s->int_ena_mask = 0;
+    qemu_set_irq(s->irq, 0);
+    /* The external lines keep driving their levels across reset; resynchronise
+     * the cached levels, otherwise the first edge after reset is lost. */
+    esp32_gpio_refresh_levels(s, 0);
 }
 

+/* The grayscale pass of the driver (Uc8253X3Driver::copyGrayscaleLsb/Msb) writes
+ * the LSB plane to DTM1 and the MSB plane to DTM2 with only a DATA_STOP in
+ * between, then refreshes. No BW pass leaves that tail: a fast/half sync only
+ * writes DTM2, a full sync starts from a constant 0xFF fill of DTM1, and the
+ * baseline syncs that follow a refresh are separated from the next DTM2 by the
+ * LUT bank load. The two DTM planes are therefore a 4-level code, not a picture
+ * plus its previous frame. */
+static bool xteink_uc8253_gray4_refresh(XteinkUc8253State *s)
+{
+    return s->last_dtm2_after_dtm1;
+}
+
+/* Close the plane payload that just ended (called before every command, so the
+ * payload of DTM1/DTM2 is complete even when the next command is the refresh). */
+static void xteink_uc8253_close_payload(XteinkUc8253State *s)
+{
+    if (s->plane_idx < 0 || s->plane_pos == 0) {
+        return;
+    }
+    if (s->plane_idx == XTEINK_UC8253_PLANE_DTM1) {
+        /* A full BW sync starts from a constant 0xFF (white) fill of DTM1; that
+         * is a baseline, not a picture, and must not read as a gray LSB plane. */
+        s->pipe_dtm1_ready = true;
+        s->pipe_dtm1_fill = s->payload_same && s->payload_first == 0xff;
+    } else {
+        s->last_dtm2_after_dtm1 = s->dtm2_after_dtm1;
+        s->dtm2_after_dtm1 = false;
+        s->pipe_dtm1_ready = false;
+    }
+}
+
+/* Compose what the panel shows from a refresh.
+ *
+ * BW refresh: the new picture is in DTM2 (1 = white, 0 = black), so the whole
+ * screen becomes that picture.
+ *
+ * 4-level refresh: the RAM pair is a code, not a picture -- (MSB,LSB) = (0,0)
+ * leaves the pixel as the BW pass drew it, (1,0) lightens it to light gray,
+ * (0,1) to dark gray and (1,1) keeps it black. The page the user is reading is
+ * the BW picture underneath, which is exactly what the driver relies on
+ * (Uc8253X3Driver::displayGray "nudges" the frame already on the panel). */
+static void xteink_uc8253_update_screen(XteinkUc8253State *s)
+{
+    const uint8_t *dtm1 = s->plane[XTEINK_UC8253_PLANE_DTM1];
+    const uint8_t *dtm2 = s->plane[XTEINK_UC8253_PLANE_DTM2];
+    uint8_t *scr_msb = s->plane[XTEINK_UC8253_PLANE_SCREEN_MSB];
+    uint8_t *scr_lsb = s->plane[XTEINK_UC8253_PLANE_SCREEN_LSB];
+    uint32_t i;
+
+    s->frame_gray4 = xteink_uc8253_gray4_refresh(s);
+    /* A refresh consumes the RAM pair: the next one needs its own DTM2 payload,
+     * so a later windowed refresh without plane data does not inherit it. */
+    s->last_dtm2_after_dtm1 = false;
+
+    if (!s->frame_gray4) {
+        for (i = 0; i < XTEINK_UC8253_PLANE_SIZE; i++) {
+            /* White -> level 0, black -> level 3. */
+            uint8_t ink = (uint8_t)~dtm2[i];
+
+            scr_msb[i] = ink;
+            scr_lsb[i] = ink;
+        }
+        return;
+    }
+
+    for (i = 0; i < XTEINK_UC8253_PLANE_SIZE; i++) {
+        uint8_t msb = dtm2[i];
+        uint8_t lsb = dtm1[i];
+        uint8_t out_msb, out_lsb;
+        int bit;
+
+        if (!msb && !lsb) {
+            continue;   /* code (0,0) everywhere in this byte: page unchanged */
+        }
+        out_msb = scr_msb[i];
+        out_lsb = scr_lsb[i];
+        for (bit = 7; bit >= 0; bit--) {
+            unsigned code = (((msb >> bit) & 1u) << 1) | ((lsb >> bit) & 1u);
+            unsigned level;
+
+            if (code == 0) {
+                continue;
+            }
+            level = (code == 2) ? 1 : (code == 1) ? 2 : 3;
+            if (level & 2) {
+                out_msb |= (uint8_t)(1u << bit);
+            } else {
+                out_msb &= (uint8_t)~(1u << bit);
+            }
+            if (level & 1) {
+                out_lsb |= (uint8_t)(1u << bit);
+            } else {
+                out_lsb &= (uint8_t)~(1u << bit);
+            }
+        }
+        scr_msb[i] = out_msb;
+        scr_lsb[i] = out_lsb;
+    }
+}

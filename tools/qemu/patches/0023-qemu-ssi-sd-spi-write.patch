 /* data accepted */
 #define DATA_RESPONSE_ACCEPTED  0x05
 
+/* How many polled bytes the card reports "busy" after accepting a block. Eight
+ * is enough for the trace and for a driver to see a real programming phase, and
+ * short enough that a host which does not poll at all is not affected. */
+#define SSI_SD_WRITE_BUSY_BYTES 8
+
+/* Decide the next phase after the last byte of a response.
+ *
+ * The decision is taken on the same byte that carries the last response byte
+ * and not one byte later: in SPI the host starts the next phase immediately
+ * after the R1 — for a write that next byte *is* the 0xFE data token. A
+ * one-byte lag therefore ate the token itself and every following data byte was
+ * decoded as a command, which is why CMD24 never received its data and SdFat
+ * gave up with R1 = 0x04 after the card had already left the transfer state
+ * (Q6).
+ */
+static void ssi_sd_response_done(ssi_sd_state *s)
+{
+    if (s->stopping) {
+        s->stopping = 0;
+        s->mode = SSI_SD_CMD;
+    } else if (s->busy_bytes > 0) {
+        s->mode = SSI_SD_WRITE_BUSY;
+    } else if (sdbus_data_ready(&s->sdbus)) {
+        s->mode = SSI_SD_PREP_DATA;
+    } else {
+        /* No data to read: either plain command mode, or a write is pending and
+         * the engine waits for its data token there. */
+        s->mode = SSI_SD_CMD;
+    }
+}

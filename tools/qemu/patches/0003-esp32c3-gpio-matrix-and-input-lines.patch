+/* Translate a GPIO-matrix register address into a pin index.
+ * Returns -1 when @addr does not belong to the per-pin window starting at
+ * @base. */
+static int esp32_gpio_pin_from_addr(Esp32GpioState *s, hwaddr addr,
+                                    uint32_t base)
+{
+    hwaddr off;
+    unsigned pin;
 
+    if (!base || addr < base) {
+        return -1;
+    }
+    off = addr - base;
+    if (off % 4) {
+        return -1;
+    }
+    pin = off / 4;
+    if (pin >= s->num_gpios || pin >= ESP_GPIO_MAX_PINS) {
+        return -1;
+    }
+    return pin;
+}
 

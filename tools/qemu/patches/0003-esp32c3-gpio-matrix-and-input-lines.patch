+static void esp32_gpio_in_handler(void *opaque, int pin, int level)
+{
+    Esp32GpioState *s = ESP32_GPIO(opaque);
+
+    if (pin < 0 || pin >= ESP_GPIO_MAX_PINS) {
+        return;
+    }
+
+    if (level) {
+        s->gpio_in |= 1u << pin;
+    } else {
+        s->gpio_in &= ~(1u << pin);
+    }
+    s->gpio_in_mask |= 1u << pin;
+}

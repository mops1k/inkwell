     for (int i_cmd = 0; i_cmd < ESP32_I2C_CMD_COUNT && !stop_or_end; ++i_cmd) {
         uint32_t cmd = s->cmd_reg[i_cmd];
         char opcode = FIELD_EX32(cmd, I2C_CMD, OPCODE);
+
+        /* The i2c v2 (ESP32-C3) command map swaps READ and STOP. */
+        if (s->riscv_cmd_encoding) {
+            if (opcode == I2C_OPCODE_READ_C3) {
+                opcode = I2C_OPCODE_READ;
+            } else if (opcode == I2C_OPCODE_STOP_C3) {
+                opcode = I2C_OPCODE_STOP;
+            }
+        }
         switch (opcode) {
             case I2C_OPCODE_RSTART:
             case I2C_OPCODE_RSTART_C3:
@@ -262,10 +272,20 @@
     fifo8_create(&s->rx_fifo, ESP32_I2C_FIFO_LENGTH);
 }
 
+static Property esp32_i2c_properties[] = {
+    /* Select the i2c v2 command encoding used by the RISC-V parts (ESP32-C3):
+     * READ=3 and STOP=2 instead of the Xtensa map READ=2, STOP=3. */
+    DEFINE_PROP_BOOL("riscv-cmd-encoding", Esp32I2CState, riscv_cmd_encoding, false),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
 static void esp32_i2c_class_init(ObjectClass * klass, void * data)
 {
+    DeviceClass *dc = DEVICE_CLASS(klass);
     ResettableClass *rc = RESETTABLE_CLASS(klass);

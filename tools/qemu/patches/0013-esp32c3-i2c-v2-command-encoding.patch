 /* I2C_CMD.OPCODE values.
  *
- * The original ESP32 (Xtensa) encodes a repeated START as 0. The ESP32-C3 and
- * the other RISC-V parts encode it as 6, while WRITE/READ/STOP/END keep their
- * values. The model is shared by both families, so both encodings must be
- * accepted: treating 6 as an unknown opcode silently breaks every
- * write-then-read transaction on the C3 (the gauge, RTC and touch probes). */
+ * The original ESP32 (Xtensa, i2c v1) encodes a repeated START as 0, READ as 2
+ * and STOP as 3. The ESP32-C3 — like the other RISC-V parts and i2c v2 in
+ * general — encodes a repeated START as 6, but also *swaps* READ and STOP:
+ * READ is 3 and STOP is 2 (hal/esp32c3/include/hal/i2c_ll.h:
+ * I2C_LL_CMD_READ 3, I2C_LL_CMD_STOP 2).
+ *
+ * The model is shared by both families, so the encoding is selected per
+ * instance through the "riscv-cmd-encoding" property, which the C3 machine
+ * sets. Getting this wrong is silent: a READ decoded as STOP ends the
+ * transaction early, TRANS_COMPLETE is raised with an empty RX FIFO, and the
+ * driver reports a failed transfer instead of a bus error. */
 typedef enum {
-    I2C_OPCODE_RSTART    = 0,
+    I2C_OPCODE_RSTART    = 0,   /* i2c v1 (Xtensa ESP32) */
     I2C_OPCODE_WRITE     = 1,
     I2C_OPCODE_READ      = 2,
     I2C_OPCODE_STOP      = 3,
     I2C_OPCODE_END       = 4,
-    I2C_OPCODE_RSTART_C3 = 6,
+    I2C_OPCODE_RSTART_C3 = 6,   /* i2c v2 (ESP32-C3 and other RISC-V parts) */
+    I2C_OPCODE_STOP_C3   = 2,   /* same value as I2C_OPCODE_READ above */
+    I2C_OPCODE_READ_C3   = 3,   /* same value as I2C_OPCODE_STOP above */
 } i2c_opcode_t;
 
 #endif /* ESP32_I2C_H */

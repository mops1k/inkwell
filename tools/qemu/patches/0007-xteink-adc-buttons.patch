+/* ADC-ladder buttons: report the per-key raw value while held, the idle value
+ * (no key pressed) otherwise. */
+static void xteink_buttons_set_adc(XteinkButtonsState *s, int idx, bool pressed)
+{
+    if (!s->saradc || s->adc_pin[idx] == ESP_GPIO_PIN_UNSET) {
+        return;
+    }
+    esp32c3_saradc_set_channel_raw(s->saradc, s->adc_pin[idx],
+                                   pressed ? s->adc_raw[idx]
+                                           : s->saradc->idle_raw);
+}

+static uint32_t xteink_uc8253_env_ms(const char *name, uint32_t def)
+{
+    const char *value = getenv(name);
+    char *end = NULL;
+    unsigned long ms;
+
+    if (!value || !*value) {
+        return def;
+    }
+    ms = strtoul(value, &end, 0);
+    if (end == value || *end != '\0') {
+        info_report("[UC8253] ignoring %s=\"%s\": not a number", name, value);
+        return def;
+    }
+    return (uint32_t)ms;
+}
+
+static bool xteink_uc8253_env_flag(const char *name)
+{
+    const char *value = getenv(name);
+
+    return value && *value && strcmp(value, "0") != 0;
+}

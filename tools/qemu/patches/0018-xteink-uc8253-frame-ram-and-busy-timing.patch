+/* One record per DISPLAY_REFRESH: a fixed header plus both RAM planes. */
+static void xteink_uc8253_dump_frame(XteinkUc8253State *s)
+{
+    uint8_t header[XTEINK_UC8253_FRAME_HDR];
+    const uint32_t words[8] = {
+        XTEINK_UC8253_FRAME_MAGIC,
+        XTEINK_UC8253_FRAME_VERSION,
+        XTEINK_UC8253_WIDTH,
+        XTEINK_UC8253_HEIGHT,
+        XTEINK_UC8253_STRIDE,
+        XTEINK_UC8253_PLANES,
+        1,              /* flags: bit0 = rows are in gate order (bottom-up) */
+        s->frames,
+    };
+    int i, plane;
+
+    if (!qemu_chr_fe_backend_connected(&s->chr)) {
+        return;
+    }
+
+    for (i = 0; i < 8; i++) {
+        stl_le_p(header + i * 4, words[i]);
+    }
+    qemu_chr_fe_write_all(&s->chr, header, sizeof(header));
+    for (plane = 0; plane < XTEINK_UC8253_PLANES; plane++) {
+        qemu_chr_fe_write_all(&s->chr, s->plane[plane],
+                              XTEINK_UC8253_PLANE_SIZE);
+    }
+
+    if (s->trace_commands) {
+        info_report("[UC8253] frame #%u dumped (%dx%d, %u bytes/plane)",
+                    s->frames, XTEINK_UC8253_WIDTH, XTEINK_UC8253_HEIGHT,
+                    XTEINK_UC8253_PLANE_SIZE);
+    }
+    s->frames++;
+}
 

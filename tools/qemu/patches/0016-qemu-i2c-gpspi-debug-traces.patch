+/* Debug: register-level trace, enabled with ESP32_I2C_TRACE=1. */
+static int esp32_i2c_trace_enabled(void)
+{
+    static int cached = -1;
+    if (cached < 0) {
+        const char *e = getenv("ESP32_I2C_TRACE");
+        cached = (e && *e && *e != '0');
+    }
+    return cached;
+}
+
+#define I2C_TRACE(...) do { \
+    if (esp32_i2c_trace_enabled()) { \

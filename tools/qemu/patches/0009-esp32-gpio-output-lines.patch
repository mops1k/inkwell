+/* Push the level each pin actually drives onto its output line. A pin only
+ * drives once software has made it an output, so the level is
+ * (gpio_out & gpio_enable); external devices take their control signals from
+ * these lines (panel CS/DC/RST, SD CS, rail enables). */
+static void esp32_gpio_sync_outputs(Esp32GpioState *s)
+{
+    uint32_t eff = s->gpio_out & s->gpio_enable;
+    uint32_t diff = eff ^ s->gpio_out_eff;
+    unsigned pin;
+
+    if (!diff) {
+        return;
+    }
+
+    for (pin = 0; pin < ESP_GPIO_MAX_PINS; pin++) {
+        if (diff & (1u << pin)) {
+            qemu_set_irq(s->out_lines[pin], (eff >> pin) & 1);
+        }
+    }
+    s->gpio_out_eff = eff;
+}
+
 static void esp32_gpio_write(void *opaque, hwaddr addr,
                        uint64_t value, unsigned int size)
 {
